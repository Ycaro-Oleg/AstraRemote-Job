{
  "manifest_version": 3,
  "name": "AstraRemote-Job",
  "version": "0.1.0",
  "description": "Fill Greenhouse, Lever, and Ashby applications from the local AstraRemote-Job vault. Never submits.",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8790/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://*.indeed.com/*",
    "https://wellfound.com/*",
    "https://*.glassdoor.com/*",
    "https://weworkremotely.com/*",
    "https://remotive.com/*",
    "https://remoteok.com/*"
  ],
  "action": {
    "default_title": "AstraRemote-Job"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://wellfound.com/*",
        "https://*.glassdoor.com/job-listing/*",
        "https://*.glassdoor.com/Job/*",
        "https://weworkremotely.com/remote-jobs/*",
        "https://remotive.com/remote-jobs/*",
        "https://remoteok.com/*"
      ],
      "js": ["capture.js"]
    }
  ]
}
