# Local server
PORT=8790
HOST=127.0.0.1

# LLM — used for cover letters, "why this company", and optional resume tailoring.
# Hunting/scoring does NOT call the model.
#
# Providers: deepseek | openrouter | xai | openai_compatible
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Only required for openai_compatible, or to override a provider default:
# LLM_BASE_URL=https://api.deepseek.com
