# Local server
PORT=8790
HOST=127.0.0.1

# LLM — used for cover letters, "why this company", and optional resume tailoring.
# Hunting/scoring does NOT call the model.
#
# Providers: deepseek | openrouter | xai | openai_compatible
#
# Gratis de verdade (rate-limited): OpenRouter, sem cartao.
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openrouter/free
# ou um id :free ao vivo em https://openrouter.ai/models?max_price=0
#   qwen/qwen3-coder:free   openai/gpt-oss-20b:free
#
# Barato e estavel pra semana de 100 apps: DeepSeek pago (centavos).
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openrouter/free
# Only required for openai_compatible, or to override a provider default:
# LLM_BASE_URL=https://openrouter.ai/api/v1
